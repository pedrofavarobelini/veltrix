APP_NAME="PedroCore IA"
APP_ENV="development"
API_PORT=3333

DEFAULT_PROVIDER="mock"
DEFAULT_MODEL="mock-v1"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.2-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

XAI_API_KEY=""
XAI_MODEL="grok-4.3"
XAI_BASE_URL="https://api.x.ai/v1"

# Autenticacao interna opcional do /api/orchestrate (sem valor real; nao versionar chave real)
#
# ATENCAO: esta chave GLOBAL apenas AUTENTICA a requisicao. Ela nao prova
# projeto: o caller recebe identidade `ambiguous`, projeto `shared_or_unknown`,
# papel de consumidor comum e NENHUM provider real. Para que um sistema
# consumidor alcance provider real, use o registro de callers abaixo.
PEDROCORE_INTERNAL_API_KEY=""

# ---------------------------------------------------------------------------
# Registro de callers (MULTI-PROVIDER-SAFE-EVOLUTION, Etapa 2)
# ---------------------------------------------------------------------------
# JSON com a lista de credenciais registradas. E a UNICA forma de estabelecer
# identidade confiavel de projeto (`identity_strength=registered`) e, portanto,
# a unica forma de um consumidor alcancar provider real.
#
# Quando configurado, o comportamento e fail-closed: requisicao sem credencial
# ou com credencial nao registrada e REJEITADA, e um JSON invalido bloqueia
# todas as requisicoes.
#
# Formato (uma entrada por sistema consumidor):
#   [
#     {
#       "credential_id": "finguard-personal-assistant",
#       "api_key": "<somente por ambiente/runtime; NUNCA versionar>",
#       "project_id": "finguard",
#       "role": "common_consumer",
#       "environment": "development",
#       "allowed_origins": ["finguard"]
#     }
#   ]
#
# Campos:
#   credential_id   identificador nao-secreto usado na auditoria
#   api_key         valor secreto; ausente deste arquivo por design
#   project_id      soberano: define o projeto, o payload nunca o define
#   role            common_consumer | technical_tool (menor privilegio no default)
#   environment     development | dev | local | test | testing | qa | staging |
#                   prod | production — producao e sempre explicita, nunca por wildcard
#   allowed_origins origens que a credencial pode alegar em `origin_system`;
#                   omitido, o default e apenas o proprio project_id
#
# Exemplo Structa (placeholder; nunca versionar o valor real de api_key):
#   {
#     "credential_id": "structa-report-intelligence",
#     "api_key": "<somente por ambiente/runtime; NUNCA versionar>",
#     "project_id": "structa",
#     "role": "technical_tool",
#     "environment": "development",
#     "allowed_origins": ["structa"]
#   }
#
# A matriz de autorizacao (provider_authorization/service.py) libera Gemini
# para `finguard`/`finguard-local` conforme regras existentes; para `structa`,
# somente identidade `registered`, papel `technical_tool` e ambiente nao
# produtivo; e para `pedrocore`, a regra tecnica local existente. Qualquer
# outra combinacao e negada por default.
PEDROCORE_CALLER_REGISTRY=""

# Identificador nao-secreto da credencial global, usado apenas na auditoria.
PEDROCORE_INTERNAL_CREDENTIAL_ID=""

# ---------------------------------------------------------------------------
# Roteamento de providers (Etapas 4 a 7) — todos default OFF
# ---------------------------------------------------------------------------
# Modo do motor de roteamento: legacy | shadow | enforced
#   legacy   (default) a politica nao influencia a execucao
#   shadow   a politica e calculada e auditada, mas nao executa
#   enforced a politica escolhe o candidato real efetivamente executado
PEDROCORE_PROVIDER_ROUTING_MODE=legacy

# Circuit breaker por provider. Default DESLIGADO.
PEDROCORE_CIRCUIT_BREAKER_ENABLED=false

# Fallback real para provider secundario. Default DESLIGADO e, quando ligado,
# no maximo secundario: nunca executa dois providers em paralelo e so entra
# apos falha pre-dispatch comprovada.
PEDROCORE_REAL_FALLBACK_ENABLED=false

# PEDROCORE_PROVIDER_TIMEOUT_SECONDS (timeout POR TENTATIVA de provider) e
# PEDROCORE_OBSERVABILITY_* estao declarados mais abaixo neste arquivo.
#
# Nota para sistemas consumidores: use um timeout MAIOR que
# PEDROCORE_PROVIDER_TIMEOUT_SECONDS mais a margem de normalizacao. Abortar
# antes faz o consumidor cair em fallback enquanto o PedroCore ainda trabalha,
# gastando token do provider sem entregar a resposta.

# Artifact Reader controlado (Bloco 9) — desabilitado por padrao, sem valor real
PEDROCORE_ARTIFACT_READER_ENABLED=false
PEDROCORE_ARTIFACT_ALLOWED_DIRS=""
PEDROCORE_ARTIFACT_MAX_FILE_CHARS=20000
PEDROCORE_ARTIFACT_MAX_TOTAL_CHARS=100000
PEDROCORE_ARTIFACT_ALLOWED_EXTENSIONS=".txt,.md,.log,.json,.csv"

# Testes opt-in de recursos reais (IMPLEMENT-05) — nunca true por padrao
PEDROCORE_RUN_REAL_INTEGRATION_TESTS=false
PEDROCORE_RUN_REAL_FINGUARD_TESTS=false
PEDROCORE_RUN_REAL_PROVIDER_TESTS=false
PEDROCORE_RUN_REAL_GEMINI_TESTS=false
PEDROCORE_RUN_REAL_PLAYWRIGHT_TESTS=false
PEDROCORE_RUN_REAL_OCR_TESTS=false
PEDROCORE_RUN_REAL_MULTIMODAL_TESTS=false

# Observabilidade tecnica local/QA — desligada por padrao, bloqueada em producao
PEDROCORE_OBSERVABILITY_ENABLED=false
PEDROCORE_OBSERVABILITY_MAX_ENTRIES=200
PEDROCORE_PROVIDER_TIMEOUT_SECONDS=30
PEDROCORE_QA_FORCE_TOTAL_PROVIDER_FAILURE=false
PEDROCORE_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# OCR local opt-in (IMPLEMENT-05D)
PEDROCORE_OCR_ENABLED=false
PEDROCORE_OCR_ENGINE=local

# QA visual multimodal opt-in (IMPLEMENT-05E)
PEDROCORE_MULTIMODAL_PROVIDER_ENABLED=false
PEDROCORE_VISUAL_QA_ENABLED=false

# Playwright read-only opt-in (IMPLEMENT-05F)
PEDROCORE_EXPLORATION_PLAYWRIGHT_ENABLED=false
PEDROCORE_EXPLORATION_ALLOWED_BASE_URLS="http://localhost:5173,http://localhost:3333"

# Enforcement final (FINALIZE-06A) — seguranca por padrao
PEDROCORE_RELEASE_REQUIRE_HUMAN_REVIEW_FOR_REAL_FEATURES=true
PEDROCORE_ENFORCE_PROJECT_POLICY=true

# Memoria tecnica de relatorios (ECOSYSTEM-INTELLIGENCE-SUITE-01) — default OFF
# Valores: off | memory | local_json | postgresql
# postgresql exige URL própria do PedroCore e migração explícita:
# python -m app.modules.report_memory.migrate
PEDROCORE_REPORT_MEMORY_PERSISTENCE=off
PEDROCORE_REPORT_MEMORY_DIR=""
PEDROCORE_REPORT_MEMORY_DATABASE_URL=""
PEDROCORE_REPORT_MEMORY_RETENTION_DAYS=90

# Provider generativo local opt-in (PEDROCORE-LOCAL-MODEL-01) — default OFF
# Backend local (Ollama/llama.cpp/LM Studio) e responsabilidade do operador;
# nenhum modelo e baixado ou instalado automaticamente.
PEDROCORE_ENABLE_LOCAL_MODEL=false
PEDROCORE_LOCAL_MODEL_BACKEND=disabled
PEDROCORE_LOCAL_MODEL_ENDPOINT="http://127.0.0.1:11434"
PEDROCORE_LOCAL_MODEL_NAME=""
PEDROCORE_LOCAL_MODEL_TIMEOUT_SECONDS=30
