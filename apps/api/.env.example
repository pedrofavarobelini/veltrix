APP_NAME="PedroCore IA"
APP_ENV="development"
API_PORT=3333

DEFAULT_PROVIDER="mock"
DEFAULT_MODEL="mock-v1"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.2-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

XAI_API_KEY=""
XAI_MODEL="grok-4.3"
XAI_BASE_URL="https://api.x.ai/v1"

# Autenticacao interna opcional do /api/orchestrate (sem valor real; nao versionar chave real)
PEDROCORE_INTERNAL_API_KEY=""

# Artifact Reader controlado (Bloco 9) — desabilitado por padrao, sem valor real
PEDROCORE_ARTIFACT_READER_ENABLED=false
PEDROCORE_ARTIFACT_ALLOWED_DIRS=""
PEDROCORE_ARTIFACT_MAX_FILE_CHARS=20000
PEDROCORE_ARTIFACT_MAX_TOTAL_CHARS=100000
PEDROCORE_ARTIFACT_ALLOWED_EXTENSIONS=".txt,.md,.log,.json,.csv"
